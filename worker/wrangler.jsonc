{
    "name": "postroom-ingress",
    "main": "src/index.ts",
    "compatibility_date": "2026-07-01",
    "workers_dev": false,
    "triggers": { "crons": ["*/15 * * * *"] },
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "postroom-ingress",
            "database_id": "REPLACE_AFTER_APPROVED_BOOTSTRAP",
        },
    ],
    "vars": {
        "APP_URL": "https://REPLACE_WITH_VERIFIED_APPLICATION_HOST",
        "MAIL_DOMAIN": "REPLACE_WITH_VERIFIED_MAIL_DOMAIN",
        "SYNC_TIMEOUT_SECONDS": "120",
        "ACK_RETENTION_SECONDS": "86400",
    },
}
