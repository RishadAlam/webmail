APP_NAME=Postroom
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# SQLite is only a local convenience. Production refuses it.
DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
MAIL_MAILER=array
FILESYSTEM_DISK=local

# Strict-free mode cannot be disabled by an environment value.
STRICT_FREE_MODE=true
POSTROOM_PROVIDER=mock
POSTROOM_MOCK_OUTCOME=accepted
POSTROOM_DAILY_LIMIT=100
POSTROOM_MONTHLY_LIMIT=3000
POSTROOM_DATABASE_STOP_BYTES=786432000
MAIL_DOMAIN=postroom.test
EXTERNAL_SENDING_ENABLED=false
RESEND_SENDING_KEY=
RESEND_MANAGEMENT_KEY=
INGRESS_WORKER_URL=
INGRESS_SECRET=
VITE_APP_NAME="${APP_NAME}"
