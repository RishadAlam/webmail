APP_NAME="WebMail by Hookstack"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=webmail
DB_USERNAME=root
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
MAIL_MAILER=array
FILESYSTEM_DISK=local

# Strict-free mode cannot be disabled by an environment value.
STRICT_FREE_MODE=true
WEBMAIL_PROVIDER=mock
WEBMAIL_MOCK_OUTCOME=accepted
WEBMAIL_DAILY_LIMIT=100
WEBMAIL_MONTHLY_LIMIT=3000
WEBMAIL_DATABASE_STOP_BYTES=786432000
MAIL_DOMAIN=webmail.test
EXTERNAL_SENDING_ENABLED=false
RESEND_SENDING_KEY=
RESEND_MANAGEMENT_KEY=
INGRESS_WORKER_URL=
INGRESS_SECRET=
VITE_APP_NAME="${APP_NAME}"
